  "constraints": [
    {"id": "C-ID-UNIQUE", "severity": "error", "check": "unique_stable_ids", "rule": "同一本体类中的稳定标识必须唯一"},
    {"id": "C-REF-CLOSED", "severity": "error", "check": "reference_closure", "rule": "所有静态关系端点和实体引用必须存在"},
    {"id": "C-WORKFLOW-DAG", "severity": "error", "check": "workflow_dag", "rule": "工作流步骤依赖必须构成有向无环图"},
    {"id": "C-ALGO-IO", "severity": "error", "check": "algorithm_io_closure", "rule": "工作流步骤输入输出必须与算法能力和数据类型闭合"},
    {"id": "C-CONTRACT-CLOSED", "severity": "error", "check": "product_contract_closure", "rule": "产品契约必须引用输出、质量、证据和恢复知识"},
    {"id": "C-STRICT-REQUIRED", "severity": "error", "check": "required_policy_sections", "rule": "研究运行缺少必要场景、契约、质量或恢复知识时不得静默回退"},
    {"id": "C-RELEASE-IMMUTABLE", "severity": "error", "check": "release_file_hashes", "rule": "frozen 发布目录的文件哈希必须与 release.json 一致"},
    {"id": "C-EXPERIENCE-SEPARATE", "severity": "error", "check": "experience_hash_separation", "rule": "动态经验不得改变基础 KG 语义哈希"}
  ],
  "competency_questions": [
    {"id": "CQ01", "question": "给定灾害类型和响应阶段，需要交付哪些产品与图层？", "required_concepts": ["DisasterContext", "DataProductContract", "RequiredLayer"]},
    {"id": "CQ02", "question": "给定产品契约，哪些数据源、算法和工作流能够形成可执行闭环？", "required_concepts": ["DataNeed", "DataSource", "Algorithm", "WorkflowPattern"]},
    {"id": "CQ03", "question": "某项输出必须满足哪些字段、几何和质量阈值？", "required_concepts": ["OutputRequirement", "OutputSchemaPolicy", "QualityRequirement"]},
    {"id": "CQ04", "question": "某数据源不可用时允许使用哪些替代源，何时必须声明缺口？", "required_concepts": ["SourceContract", "AcceptableDegradation", "GapDeclarationRule"]},
    {"id": "CQ05", "question": "某算法或质量门失败后，哪些修复策略被当前产品契约授权？", "required_concepts": ["RepairStrategy", "DataProductContract", "QualityGateResult"]},
    {"id": "CQ06", "question": "规划决策引用了哪个 KG 版本、哪些实体和约束？", "required_concepts": ["PlanningDecision", "PlanningRationale", "KnowledgeRelease"]},
    {"id": "CQ07", "question": "临时产品被何种最终产品替代，证据和缺口是否完整？", "required_concepts": ["DataProduct", "DeliveryManifest", "EvidenceTrace", "GapDeclaration"]},
    {"id": "CQ08", "question": "相同基础 KG 与固定经验快照能否生成语义一致的计划？", "required_concepts": ["KnowledgeRelease", "SituationSignature", "PlanningDecision"]}
  ]
}
