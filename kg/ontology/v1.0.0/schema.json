  "identity_policy": {
    "stable_id_rule": "静态知识对象必须使用带类型前缀和版本后缀的稳定 ID；冻结版本中不得原地复用 ID 表达不同语义",
    "release_identity_fields": ["release_id", "ontology_version", "knowledge_version", "semantic_hash"],
    "runtime_kind_mappings": [
      {"section": "data_types", "class_id": "DataType", "id_field": "type_id"},
      {"section": "tasks", "class_id": "Task", "id_field": "task_id"},
      {"section": "scenario_profiles", "class_id": "ScenarioProfile", "id_field": "profile_id"},
      {"section": "product_contracts", "class_id": "DataProductContract", "id_field": "contract_id"},
      {"section": "task_bundles", "class_id": "TaskBundle", "id_field": "bundle_id"},
      {"section": "output_requirements", "class_id": "OutputRequirement", "id_field": "requirement_id"},
      {"section": "qos_policies", "class_id": "QualityRequirement", "id_field": "policy_id"},
      {"section": "data_needs", "class_id": "DataNeed", "id_field": "need_id"},
      {"section": "repair_strategies", "class_id": "RepairStrategy", "id_field": "strategy_id"},
      {"section": "algorithms", "class_id": "Algorithm", "id_field": "algo_id"},
      {"section": "parameter_specs", "class_id": "AlgorithmParameter", "id_field": ["algo_id", "key"]},
      {"section": "workflow_patterns", "class_id": "WorkflowPattern", "id_field": "pattern_id"},
      {"section": "data_sources", "class_id": "DataSource", "id_field": "source_id"},
      {"section": "output_schema_policies", "class_id": "OutputSchemaPolicy", "id_field": "policy_id"}
    ]
  },
  "properties": [
    {"id": "release_id", "domain": ["KnowledgeRelease"], "range": "string", "required": true, "immutable": true},
    {"id": "semantic_hash", "domain": ["KnowledgeRelease"], "range": "sha256", "required": true, "immutable": true},
    {"id": "experience_snapshot_hash", "domain": ["KnowledgeRelease"], "range": "sha256", "required": true, "immutable": true},
    {"id": "disaster_type", "domain": ["DisasterContext", "ScenarioProfile", "HazardVocabulary"], "range": "string", "required": true},
    {"id": "requested_tasks", "domain": ["TaskBundle"], "range": "stable_id[]", "required": true},
    {"id": "contract_id", "domain": ["DataProductContract", "FieldRequirement", "GeometryConstraint"], "range": "stable_id", "required": true},
    {"id": "required_fields", "domain": ["OutputRequirement", "FieldRequirement", "OutputSchemaPolicy"], "range": "string[]", "required": true},
    {"id": "allowed_geometry_types", "domain": ["GeometryConstraint"], "range": "string[]", "required": true},
    {"id": "quality_threshold", "domain": ["QualityRequirement", "QualityGate"], "range": "number|boolean", "required": true},
    {"id": "source_id", "domain": ["DataSource", "SourceContract"], "range": "stable_id", "required": true},
    {"id": "candidate_source_ids", "domain": ["SourceRole", "AcquisitionStrategy"], "range": "stable_id[]", "required": true},
    {"id": "fallback_source_ids", "domain": ["SourceContract", "AcquisitionStrategy"], "range": "stable_id[]", "required": false},
    {"id": "algo_id", "domain": ["Algorithm", "AlgorithmParameter", "PatternStep"], "range": "stable_id", "required": true},
    {"id": "input_types", "domain": ["Algorithm", "PatternStep"], "range": "stable_id[]", "required": true},
    {"id": "output_type", "domain": ["Algorithm", "PatternStep", "OutputSchemaPolicy"], "range": "stable_id", "required": true},
    {"id": "strategy_id", "domain": ["RepairStrategy"], "range": "stable_id", "required": true},
    {"id": "authorized_strategy_ids", "domain": ["DataProductContract", "RecoveryPolicy"], "range": "stable_id[]", "required": true},
    {"id": "policy_id", "domain": ["QualityRequirement", "SourceContract", "DecisionPolicy", "RecoveryPolicy"], "range": "stable_id", "required": true},
    {"id": "evidence_refs", "domain": ["PlanningDecision", "PlanningRationale", "EvidenceTrace"], "range": "stable_id[]", "required": true}
  ],
