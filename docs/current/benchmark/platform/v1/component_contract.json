    "requirements.txt"
  ],
  "forbidden_change_prefixes": [
    "docs/current/benchmark/v1/",
    "kg/ontology/v1.0.0/",
    "docs/current/evidence/",
    "llm/",
    "agent/",
    "services/",
    "schemas/benchmark.py"
  ],
  "dependency_policy": {
    "allowed_additions": ["jsonschema>=4.23,<5"],
    "all_other_dependency_changes_forbidden": true,
    "network_install_is_environment_setup_not_runtime_behavior": true
  },
  "components": [
    {
      "component_id": "BP-DESIGN-LOADER",
      "module": "benchmark_platform.design_loader",
      "responsibility": "Load and verify the frozen design bundle before any template or generation operation.",
      "inputs": ["design_root", "expected_tag", "expected_commit"],
      "outputs": ["FrozenDesignBundle"],
      "fail_closed_on": ["tag_mismatch", "asset_hash_mismatch", "identity_mismatch", "missing_reference"],
      "forbidden_dependencies": ["network", "llm", "provider", "judge"]
    },
    {
      "component_id": "BP-MODELS",
      "module": "benchmark_platform.models",
      "responsibility": "Provide Pydantic V2 closed runtime models and typed failure records independent of legacy Freeze B models.",
      "inputs": ["json_objects"],
      "outputs": ["validated_runtime_models", "typed_validation_failures"],
      "fail_closed_on": ["unknown_field", "invalid_state", "unknown_enum", "duplicate_id"],
      "forbidden_dependencies": ["schemas.benchmark", "network", "llm"]
    },
    {
      "component_id": "BP-CANONICAL",
      "module": "benchmark_platform.canonical",
      "responsibility": "Produce canonical UTF-8 JSON, stable IDs, derived seeds and SHA-256 digests.",
      "inputs": ["validated_object", "seed_namespace", "master_seed", "unit_index"],
      "outputs": ["canonical_bytes", "content_sha256", "stable_id", "derived_seed"],
      "fail_closed_on": ["nan_or_infinity", "unsupported_type", "missing_identity_field"],
      "forbidden_dependencies": ["global_random_state", "network"]
    },
    {
      "component_id": "BP-CROSSWALK",
      "module": "benchmark_platform.crosswalk",
      "responsibility": "Validate KG, source, contract, algorithm and quality-policy IDs against frozen read-only registries.",
      "inputs": ["FrozenDesignBundle", "DevelopmentTemplate"],
      "outputs": ["CrosswalkReport"],
      "fail_closed_on": ["unknown_id", "wrong_kg_release", "duplicate_binding", "ambiguous_binding"],
      "forbidden_dependencies": ["kg_write", "neo4j_write", "network"]
    },
    {
      "component_id": "BP-GENERATOR",
      "module": "benchmark_platform.generator",
      "responsibility": "Generate deterministic development-only experiment units and retain every attempt.",
      "inputs": ["FrozenDesignBundle", "DevelopmentTemplate", "GenerationRequest"],
      "outputs": ["GenerationAttempt", "GeneratedUnit"],
      "fail_closed_on": ["non_development_partition", "seed_mismatch", "attempt_limit", "invalid_member"],
      "forbidden_dependencies": ["confirmation", "selective_e2e", "network", "llm", "provider", "judge"]
    },
    {
      "component_id": "BP-RELATIONS",
      "module": "benchmark_platform.relations",
      "responsibility": "Validate counterfactual, invariant, composition and temporal relations with one primary failure.",
      "inputs": ["GeneratedUnit", "relation_assertions", "frozen_failure_taxonomy"],
      "outputs": ["RelationValidationReport"],
      "fail_closed_on": ["multi_causal_drift", "invariant_drift", "cross_task_pollution", "illegal_transition", "unknown_failure_class"],
      "forbidden_dependencies": ["keyword_semantic_scoring", "llm_judge"]
    },
    {
      "component_id": "BP-VIEWS",
      "module": "benchmark_platform.views",
      "responsibility": "Project planner, evaluator and human-blind packets from explicit allowlists and audit leakage.",
      "inputs": ["GeneratedUnit", "frozen_view_contract"],
      "outputs": ["PlannerPacket", "EvaluatorPacket", "HumanBlindPacket", "LeakageAudit"],
      "fail_closed_on": ["forbidden_path_visible", "gold_value_leak", "condition_label_leak", "run_identity_leak"],
      "forbidden_dependencies": ["blacklist_only_projection", "llm"]
    },
    {
      "component_id": "BP-STORE",
      "module": "benchmark_platform.store",
      "responsibility": "Write new atomic run artifacts and checkpoints and validate resume bindings.",
      "inputs": ["run_request", "stage_outputs", "resume_request"],
      "outputs": ["run_root", "checkpoint", "checksums"],
      "fail_closed_on": ["output_exists", "resume_hash_drift", "illegal_stage", "partial_publish"],
      "forbidden_dependencies": ["service_runtime", "celery", "redis", "database", "network"]
    },
    {
      "component_id": "BP-CLI",
      "module": "benchmark_platform.cli",
      "responsibility": "Expose only the bounded offline commands declared by this contract.",
      "inputs": ["command", "validated_arguments"],
      "outputs": ["structured_stdout", "structured_stderr", "exit_code"],
      "fail_closed_on": ["unknown_command", "forbidden_partition", "invalid_argument", "unhandled_failure"],
      "forbidden_dependencies": ["web_ui", "api_server", "network", "llm", "provider", "judge"]
    }
  ],
  "experiment_unit_types": ["single", "counterfactual_pair", "invariant_set", "composition_family", "temporal_trace"],
  "allowed_cli_commands": [
    "validate-design",
    "validate-template",
    "generate-development",
    "validate-run",
    "project-views",
    "audit-run",
    "resume-development"
  ],
