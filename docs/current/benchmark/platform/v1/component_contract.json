  ],
  "state_machine": [
    "created",
    "design_bound",
    "templates_validated",
    "generated",
    "relations_validated",
    "views_projected",
    "audited",
    "development_complete"
  ],
  "terminal_failure_state": "failed_retained",
  "recovery_invariants": [
    "resume_requires_explicit_checkpoint",
    "all_input_hashes_must_match",
    "code_revision_must_match",
    "output_root_is_never_overwritten",
    "hash_drift_requires_new_run_id"
  ],
  "implementation_stages": [
