      "description": "Flood response prioritizes water polygons, waterways, and roads while building is explicitly deferred.",
      "request": {
        "scenario_name": "C02 Caracas flood water and road priority",
        "trigger_content": "Caracas flood response: execute water polygon, waterways, and road fusion in that order; building is deferred.",
        "disaster_type": "flood",
        "job_types": [],
        "spatial_extent": "bbox(-67.17,10.38,-66.86,10.57)",
        "force_aoi_resolution": false,
        "target_crs": "EPSG:32619",
        "debug": false,
        "metadata": {
          "requested_task_kinds": ["water_polygon", "waterways", "road"],
          "requested_layers_present": true,
          "provisional_task_kinds": ["water_polygon"],
          "deferred_task_kinds": ["building"]
        }
      },
      "resource_regime": {
        "network": "moderate",
        "time": "tight",
        "aoi_scale": "capital_district",
        "source_condition": "HydroLAKES deferred; HydroRIVERS and roads available"
      },
      "expected_layer_priority": ["water_polygon", "waterways", "road"],
      "expected_delivery_strategy": "Deliver water/road evidence first; allow provisional water_polygon while declaring the missing HydroLAKES reference.",
      "expected_gap_types": ["source_unavailable", "quality_failed"],
      "stages": [
        {
          "stage_id": "priority_delivery",
          "action": "create",
          "active_source_ids": ["raw.osm.water", "raw.osm.waterways", "raw.hydrorivers.water", "raw.osm.road", "raw.microsoft.road", "aoi.venezuela_capital_district"],
          "expected_phases": ["partial", "partial_provisional", "succeeded"],
          "expected_task_order": ["water_polygon", "waterways", "road"],
          "assertions": {
            "building_deferred": true,
            "water_priority": true
          }
        }
      ]
    },
